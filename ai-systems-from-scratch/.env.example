# AI Systems From Scratch - Environment Variables
# Copy this file to .env and adjust configuration as needed.

# Hardware Tier Selection (tier1_cpu, tier2_single_gpu, tier3_multi_gpu)
AI_SYSTEMS_TIER=tier1_cpu

# Device Selection (cpu, cuda, mps)
DEVICE=cpu

# Precision Policy (float32, bfloat16, float16)
DEFAULT_DTYPE=float32

# Compiler Settings
TORCH_COMPILE_BACKEND=inductor
TORCH_COMPILE_MODE=default
TORCH_LOGS=+dynamo,+inductor

# Optional API Keys for Real Tool Evaluation / Judge (NOT required for core from-scratch labs)
# The course builds all primitives locally without external paid dependencies.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
HF_TOKEN=

# Evaluation & Observability
EVAL_LOG_DIR=outputs/eval_logs
TRACING_ENABLED=true
MAX_AGENT_TURNS=10
DEFAULT_BUDGET_USD=0.50
