# ==============================================================================
# aws-from-scratch: Environment Configuration Template
# Copy this file to .env: cp .env.example .env
#
# CRITICAL SECURITY WARNING:
# NEVER put AWS_ACCESS_KEY_ID or AWS_SECRET_ACCESS_KEY in this file!
# Use 'aws configure sso' or AWS Identity Center or short-lived credentials.
# ==============================================================================

# Target AWS Region for Labs
AWS_REGION=us-east-1

# Named AWS CLI Profile (e.g. default, sandbox, lab)
AWS_PROFILE=default

# Standard Lab Resource Tagging
LAB_PROJECT_NAME=aws-from-scratch
LAB_TAG_ENVIRONMENT=learning

# Budget Threshold Alert Email (for scripts/setup-budget.sh)
LAB_ALERT_EMAIL=learner@example.com

# Local Simulation Port
SIMULATOR_PORT=8000
