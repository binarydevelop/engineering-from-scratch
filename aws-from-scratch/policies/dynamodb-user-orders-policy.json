{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowScopedDynamoDBOrderAccess",
      "Effect": "Allow",
      "Action": [
        "dynamodb:GetItem",
        "dynamodb:PutItem",
        "dynamodb:UpdateItem",
        "dynamodb:DeleteItem",
        "dynamodb:Query"
      ],
      "Resource": [
        "arn:aws:dynamodb:*:*:table/aws-from-scratch-orders",
        "arn:aws:dynamodb:*:*:table/aws-from-scratch-orders/index/*"
      ]
    },
    {
      "Sid": "DenyTableDeletionOrModification",
      "Effect": "Deny",
      "Action": [
        "dynamodb:DeleteTable",
        "dynamodb:UpdateTable"
      ],
      "Resource": "*"
    }
  ]
}
