# Environment Configuration
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Security
SECRET_KEY=change-this-in-production-to-at-least-32-random-bytes
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Database (PostgreSQL / SQLite)
DATABASE_URL=sqlite:///./dev_backend.db
# For PostgreSQL labs:
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_dev

# Redis (Caching & Rate Limiting)
REDIS_URL=redis://localhost:6379/0

# Rate Limiting Defaults
RATE_LIMIT_RPS=50
RATE_LIMIT_BURST=100

# Observability
LOG_LEVEL=INFO
METRICS_PORT=9090
