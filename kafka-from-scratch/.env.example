# ==============================================================================
# kafka-from-scratch Configuration Environment Variables
# ==============================================================================

# Kafka Cluster Configuration
KAFKA_VERSION=3.8.0
KAFKA_IMAGE=apache/kafka:3.8.0
KAFKA_CLUSTER_ID=4L622nShTUiBenA3heAaGw

# Single-Broker Local Lab Ports
KAFKA_BROKER_PORT=9092
KAFKA_CONTROLLER_PORT=9093

# Multi-Broker Cluster Lab Ports
KAFKA_NODE_1_PORT=9092
KAFKA_NODE_2_PORT=9094
KAFKA_NODE_3_PORT=9096

# Host connectivity
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
CLUSTER_BOOTSTRAP_SERVERS=localhost:9092,localhost:9094,localhost:9096

# Python client logging
LOG_LEVEL=INFO
