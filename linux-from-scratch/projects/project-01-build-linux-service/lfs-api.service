[Unit]
Description=LFS Production HTTP Service
After=network.target

[Service]
Type=simple
User=lfs-service
Group=lfs-service
WorkingDirectory=/opt/lfs-api
EnvironmentFile=/etc/lfs-api/server.env
ExecStart=/usr/bin/python3 /opt/lfs-api/server.py
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal

# Sandboxing & Security
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/opt/lfs-api/data

[Install]
WantedBy=multi-user.target
