datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Task {
  id              String   @id @default(cuid())
  taskName        String
  date            String   // Format: YYYY-MM-DD
  sprint          String
  week            String
  phaseRepos      String
  dsaTrack        String
  morningSession  String
  eveningSession  String
  status          String   @default("To Do") // "To Do", "In Progress", "Done"
  priority        String   @default("Medium") // "Low", "Medium", "High", "Critical"
  notes           String   @default("")
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([date])
  @@index([sprint])
  @@index([status])
}

model Resource {
  id          String   @id @default(cuid())
  repoId      String   // e.g. "operating-systems-from-scratch"
  phaseId     String?  // optional: e.g. "01-what-is-an-operating-system"
  title       String
  url         String
  type        String   @default("article") // "youtube", "article", "doc", "interactive", "embed"
  embedUrl    String?
  description String   @default("")
  tags        String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([repoId])
  @@index([phaseId])
}

