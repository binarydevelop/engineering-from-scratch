# NoSQL Databases Laboratory Environment Configuration

# MongoDB Configuration
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DATABASE=nosql_scratch
MONGO_USER=nosql_admin
MONGO_PASS=nosql_secret

# Apache Cassandra Configuration
CASSANDRA_HOST=localhost
CASSANDRA_PORT=9042
CASSANDRA_KEYSPACE=nosql_scratch

# DynamoDB Local Configuration
DYNAMODB_ENDPOINT=http://localhost:8000
AWS_DEFAULT_REGION=us-east-1
AWS_ACCESS_KEY_ID=local_access_key
AWS_SECRET_ACCESS_KEY=local_secret_key

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Neo4j Graph Database Configuration
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=nosql_secret

# Elasticsearch Configuration
ELASTICSEARCH_HOST=http://localhost:9200
ELASTICSEARCH_USER=
ELASTICSEARCH_PASSWORD=

# Lab Safety and Limits
AUTO_CLEANUP=true
MAX_EXECUTION_TIME_SECONDS=60
MAX_RECORDS_DEFAULT=10000
