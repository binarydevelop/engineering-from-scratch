# OLAP Databases and Analytical Querying from Scratch - Environment Configuration

# DuckDB (Local Vectorized In-Process Analytical Engine)
DUCKDB_PATH=outputs/olap_lab.duckdb
DUCKDB_THREADS=4
DUCKDB_MEMORY_LIMIT=4GB

# ClickHouse (High-Performance Columnar OLAP DBMS)
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=clickhouse
CLICKHOUSE_DB=olaplab

# PostgreSQL (OLTP Baseline Comparison Engine)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=sqllab

# Apache Druid (Time-Series & Event Stream OLAP)
DRUID_COORDINATOR_PORT=8081
DRUID_BROKER_PORT=8082
DRUID_ROUTER_PORT=8888

# Apache Pinot (Real-Time Low-Latency Analytical Serving)
PINOT_CONTROLLER_PORT=9000
PINOT_BROKER_PORT=8099
PINOT_SERVER_PORT=8098

# Benchmark and Execution Controls
BENCHMARK_WARMUP_RUNS=3
BENCHMARK_MEASURE_RUNS=5
BENCHMARK_DATASET_SCALE=1000000
BENCHMARK_CONCURRENCY=1
