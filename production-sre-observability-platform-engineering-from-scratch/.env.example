# Environment Configuration for Production SRE Lab Stack

# Environment Name
ENVIRONMENT=lab-local
LOG_LEVEL=INFO

# Networking & Ports
API_GATEWAY_PORT=8000
CHECKOUT_SERVICE_PORT=8001
INVENTORY_SERVICE_PORT=8002
PAYMENT_SERVICE_PORT=8003
NOTIFICATION_WORKER_PORT=8004

# PostgreSQL Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=production_store
POSTGRES_USER=sre_admin
POSTGRES_PASSWORD=reliable_production_secret_2026
POSTGRES_MAX_CONNECTIONS=50

# Redis Cache & Broker
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# OpenTelemetry Collector Endpoints
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_INSECURE=true
OTEL_SERVICE_NAME=unknown-service

# Monitoring & Observability Ports
OTEL_COLLECTOR_PORT_GRPC=4317
OTEL_COLLECTOR_PORT_HTTP=4318
PROMETHEUS_PORT=9090
ALERTMANAGER_PORT=9093
GRAFANA_PORT=3000
TEMPO_PORT=3200
LOKI_PORT=3100

# Reliability & SLO Thresholds
CHECKOUT_SLO_LATENCY_P99_MS=500
CHECKOUT_SLO_AVAILABILITY_TARGET=0.999
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_RECOVERY_TIME_SEC=30
