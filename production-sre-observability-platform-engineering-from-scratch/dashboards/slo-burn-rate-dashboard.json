  "liveNow": false,
  "panels": [
    {
      "title": "Current Rolling SLI Availability (1h window)",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "sum(rate(slo_good_events_total[1h])) / sum(rate(slo_total_events_total[1h])) * 100",
          "legendFormat": "SLI Compliance %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Current 1-Hour Burn Rate",
      "type": "stat",
      "gridPos": {"h": 6, "w": 8, "x": 8, "y": 0},
      "targets": [
        {
          "expr": "(1 - (sum(rate(slo_good_events_total[1h])) / sum(rate(slo_total_events_total[1h])))) / 0.001",
          "legendFormat": "Burn Rate (x)",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Remaining 30-Day Error Budget",
      "type": "gauge",
      "gridPos": {"h": 6, "w": 8, "x": 16, "y": 0},
      "targets": [
        {
          "expr": "100 - ((1 - (sum(increase(slo_good_events_total[30d])) / sum(increase(slo_total_events_total[30d])))) / 0.001 * 100)",
          "legendFormat": "Remaining Budget %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Error Budget Burn Rate History",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 6},
      "targets": [
        {
          "expr": "(1 - (sum(rate(slo_good_events_total[5m])) / sum(rate(slo_total_events_total[5m])))) / 0.001",
          "legendFormat": "5m Burn Rate",
          "refId": "A"
        },
        {
          "expr": "(1 - (sum(rate(slo_good_events_total[1h])) / sum(rate(slo_total_events_total[1h])))) / 0.001",
          "legendFormat": "1h Burn Rate",
          "refId": "B"
        }
      ]
    }
  ],
  "schemaVersion": 39,
