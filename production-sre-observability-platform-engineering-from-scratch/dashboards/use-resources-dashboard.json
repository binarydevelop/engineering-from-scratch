    {
      "title": "PostgreSQL Connection Pool Saturation",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0},
      "targets": [
        {
          "expr": "db_pool_active_connections / db_pool_max_connections * 100",
          "legendFormat": "{{database}} Pool Saturation %",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Active vs Max Database Connections",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0},
      "targets": [
        {
          "expr": "db_pool_active_connections",
          "legendFormat": "Active Connections",
          "refId": "A"
        },
        {
          "expr": "db_pool_max_connections",
          "legendFormat": "Max Limit",
          "refId": "B"
        }
      ]
    },
    {
      "title": "Notification Worker Queue Backlog Depth",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 8},
      "targets": [
        {
          "expr": "queue_backlog_total",
          "legendFormat": "{{queue_name}} Pending Items",
          "refId": "A"
        }
      ]
    },
    {
      "title": "Worker Processing Lag (Seconds)",
      "type": "timeseries",
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 8},
      "targets": [
        {
          "expr": "worker_processing_lag_seconds",
          "legendFormat": "{{queue_name}} Oldest Message Lag (s)",
          "refId": "A"
        }
      ]
    }
