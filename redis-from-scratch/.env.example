# Redis Lab Environment Configuration

# Primary Standalone Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Replica Configuration (Phases 34-36)
REDIS_REPLICA_PORT=6380

# Sentinel Configuration (Phase 36)
SENTINEL_HOST=localhost
SENTINEL_PORT=26379
SENTINEL_MASTER_NAME=mymaster

# Relational Database for Caching Comparisons (Phases 01, 22, 42)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=redis_lab

# Benchmark & Concurrency Tuning
BENCHMARK_CONCURRENCY=50
BENCHMARK_REQUESTS=10000
